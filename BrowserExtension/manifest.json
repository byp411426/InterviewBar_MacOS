{
  "manifest_version": 3,
  "name": "面试日程 · 邮件采集",
  "version": "0.4.0",
  "description": "选中或粘贴招聘邮件文字，交给本机面试日程核对后保存。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "加入面试日程",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon.png"
    }
  },
  "icons": {
    "32": "icon.png"
  }
}